#!/bin/sh
# DogOS hardening hook (chroot). Spec section 7.
set -e

# nftables base ruleset is in includes.chroot (/etc/nftables.conf); enable it
systemctl enable nftables || true

# AppArmor on (Debian enables by default; make it explicit)
systemctl enable apparmor || true

# Bluetooth: attack surface — off by default, one click to re-enable
systemctl disable bluetooth || true

# No listening services by default — mask the usual suspects
for svc in avahi-daemon cups rpcbind nfs-client.target; do
  systemctl mask "$svc" 2>/dev/null || true
done

# Bubblewrap: sandbox wrappers for high-risk apps (X11 keylogging
# mitigation). SHIPPED (D-8, decided 2026-10-21): /usr/local/bin/
# firefox-esr-bwrap and the firefox-esr.desktop override in
# includes.chroot run Firefox-ESR inside bwrap (private /tmp, PID and
# IPC namespaces, read-only system, only ~/.mozilla and ~/Downloads
# bound from the real home). Bubblewrap itself is installed via the
# hardening package list. Sandbox behaviour is validated on the first
# build (D-3) — it cannot be proven from the source tree alone.
mkdir -p /etc/dogos/sandbox

# Amnesiac identity: randomize hostname on live boot, randomize MACs always
systemctl enable dogos-hostname || true

# Live-boot credentials (D-13, decided 2026-10-21): live media carries
# no known password — dogos-live-password generates a fresh one every
# live boot, displays it on the login screen, and locks the live
# account rather than falling back if generation fails.
systemctl enable dogos-live-password || true

# First-boot cleanup: strip live-session residue (live user, its NOPASSWD
# grant, live autologin) from Calamares-installed systems before the login
# screen. Exits quietly on live media.
systemctl enable dogos-install-cleanup || true

# Verify the security-critical enables actually landed. They are `|| true`
# above so a chroot systemctl quirk cannot fail the whole build — but a
# silent miss would ship an image whose firewall never loads. Warn loudly
# in the build log instead (warning only, never fatal).
for unit in nftables apparmor dogos-hostname dogos-live-password dogos-install-cleanup; do
  if [ ! -e "/etc/systemd/system/multi-user.target.wants/$unit.service" ]; then
    echo "WARNING: $unit.service is NOT enabled — a security control would be missing from the image"
  fi
done

echo "dogos hardening hook done"
