---
# DogOS Calamares branding. TODO(site): point product/support URLs at the
# DogOS site once it exists; for now the repo is the canonical home.
# Slideshow: none yet — Calamares falls back to the default slides when no
# slideshow/ dir is referenced (planned, see README roadmap).
componentName:  dogos

welcomeStyleCalamares: false
windowExpanding: normal
windowSize: 800px,520px
windowPlacement: center

productName:         DogOS
shortProductName:    DogOS
version:             rolling
shortVersion:        rolling
versionedName:       DogOS (rolling)
shortVersionedName:  DogOS

productUrl:          https://github.com/TheRealJesusTheHacker/DogOS
supportUrl:          https://github.com/TheRealJesusTheHacker/DogOS/issues
knownIssuesUrl:      https://github.com/TheRealJesusTheHacker/DogOS/issues
releaseNotesUrl:     https://github.com/TheRealJesusTheHacker/DogOS/releases

productIconName:     dogos
productWallpaper:    /usr/share/backgrounds/dogos/dogos-wallpaper.webp
