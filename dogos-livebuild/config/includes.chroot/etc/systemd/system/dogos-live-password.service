[Unit]
Description=DogOS live-boot password randomization (live boot only)
# D-13 (decided 2026-10-21): live media carries no known credential —
# the script generates a fresh live-user password every live boot and
# displays it on the login screen, or locks the account trying.
# Ordered after live-config (which creates the live user) and before
# the display manager, so the password is set and displayed before any
# login screen appears. The script itself exits quietly on installed
# systems (same live-media markers as dogos-hostname).
After=local-fs.target live-config.service
Before=display-manager.service

[Service]
Type=oneshot
ExecStart=/usr/local/bin/dogos-live-password
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
