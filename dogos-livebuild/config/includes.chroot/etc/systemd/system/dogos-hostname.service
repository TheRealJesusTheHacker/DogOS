[Unit]
Description=DogOS amnesiac hostname randomization (live boot only)
# NOTE: no ConditionPathExists here on purpose — the script itself exits
# quietly on installed systems. (Two ConditionPathExists= lines would be
# AND logic and the service would never start: only one live-media path
# exists per boot.)
After=network-pre.target
Before=network.target

[Service]
Type=oneshot
ExecStart=/usr/local/bin/dogos-hostname
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
