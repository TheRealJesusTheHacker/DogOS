#!/bin/bash
# dogos-live-password — randomize the live user's password on live boot.
#
# Policy (D-13, decided 2026-10-21): live media carries NO known
# credential. Every live boot generates a fresh random password for the
# live user and displays it on the login screen, so only the operator
# physically in front of the machine knows it:
#   * /etc/issue — printed above the console (getty) login prompt
#   * the live user's full name (GECOS) — shown by the LightDM greeter
#     next to the live user's entry
#   * /run/dogos/live-password — a copy for the running session; /run
#     is tmpfs, so it vanishes at shutdown like the rest of the
#     amnesiac live session (mode 0644 on purpose: its whole job is
#     to be readable at the login screen)
#
# Failure is FAIL-CLOSED, never a silent fallback: if the password
# cannot be generated or set, the live account is LOCKED (no password
# login at all), the login-screen files state that live login is
# disabled, and this script exits 1 so the failure is loud in the boot
# log. There is no default or known password to fall back to.
#
# Installed systems are untouched: like dogos-hostname, this exits
# quietly when not booted from live media — the Calamares-created user
# keeps the password chosen in the installer.
#
# Static verification only (bash -n, shellcheck, stubbed-command
# probes): boot-time behaviour is validated on the first ISO build
# (D-3, build host), not from this source tree.
set -euo pipefail
[ "$(id -u)" -eq 0 ] || { echo "error: run as root" >&2; exit 1; }

LIVE_USER="${DOGOS_LIVE_USER:-user}"
ISSUE_FILE="${DOGOS_LIVE_ISSUE_FILE:-/etc/issue}"
STATE_DIR="${DOGOS_LIVE_STATE_DIR:-/run/dogos}"

# Same sanitization as dogos-install-cleanup, applied BEFORE the value
# is interpolated anywhere: a username is [a-zA-Z0-9_-] and never starts
# with - or _. Anything else aborts (and never reaches a display file).
case "$LIVE_USER" in
  ''|*[!a-zA-Z0-9_-]*|-*|_*)
    echo "dogos-live-password: refusing — DOGOS_LIVE_USER has an unsafe value" >&2
    exit 1 ;;
esac

# Live media only (same markers as dogos-hostname / dogos-install-cleanup).
if [ ! -e /run/live/medium ] && [ ! -e /lib/live/mount/medium ]; then
  exit 0
fi

fail_closed() {
  reason="$1"
  msg="dogos-live-password: FAILED — ${reason}; locking the live account (no fallback password exists)"
  echo "$msg" >&2
  logger -t dogos-live-password "$msg" 2>/dev/null || true
  usermod -L "$LIVE_USER" 2>/dev/null || passwd -l "$LIVE_USER" 2>/dev/null || true
  rm -f "$STATE_DIR/live-password"
  printf '%s\n' \
    "DogOS live session" \
    "Live login is DISABLED on this boot: password randomization failed (${reason})." \
    "Reboot to try again — DogOS live media has no default password." \
    > "$ISSUE_FILE" 2>/dev/null || true
  exit 1
}

# The live account must exist (live-config creates it before the
# display manager starts; this unit is ordered After it). Randomizing
# a password for a missing account is a failure, not a no-op.
id "$LIVE_USER" >/dev/null 2>&1 || fail_closed "live user '$LIVE_USER' does not exist"

# Generate: 16 alphanumeric characters from /dev/urandom. Reads are
# finite (head -c on the device), so no pipe consumer closes early;
# the loop tops up until the length check passes.
PW=""
while [ "${#PW}" -lt 16 ]; do
  chunk="$(head -c 18 /dev/urandom | base64 | tr -dc 'A-Za-z0-9' || true)"
  PW="${PW}${chunk}"
done
PW="${PW:0:16}"
[ "${#PW}" -eq 16 ] || fail_closed "password generation produced a short value"

# Set it. chpasswd reads user:password on stdin.
if ! printf '%s:%s\n' "$LIVE_USER" "$PW" | chpasswd; then
  fail_closed "chpasswd could not set the live password"
fi

# Display it (see header). If the primary login-screen file cannot be
# written, the password would be set but unknowable — lock instead.
banner="DogOS live session — user: ${LIVE_USER} — password (this boot only): ${PW}"
{
  printf '%s\n' "$banner"
  printf '%s\n' "This password was generated at boot and is shown only here, on this machine."
  if [ -f "$ISSUE_FILE" ]; then cat "$ISSUE_FILE"; fi
} > "${ISSUE_FILE}.dogos-tmp" || fail_closed "could not stage the login-screen banner"
mv "${ISSUE_FILE}.dogos-tmp" "$ISSUE_FILE" || fail_closed "could not write $ISSUE_FILE"

mkdir -p "$STATE_DIR" || fail_closed "could not create $STATE_DIR"
printf '%s\n' "$banner" > "$STATE_DIR/live-password" || fail_closed "could not write the session password copy"
chmod 0644 "$STATE_DIR/live-password" || true

# Graphical login screen: LightDM's greeter shows the user's full
# name beside the account — carry the password there too. A failure
# here is loud but not fatal: the console login screen above already
# displays the password.
if ! usermod -c "DogOS live user (this boot's password: ${PW})" "$LIVE_USER"; then
  echo "dogos-live-password: WARNING — could not set the greeter full-name display; password is on the console login screen ($ISSUE_FILE)" >&2
  logger -t dogos-live-password "greeter full-name display failed; password shown in $ISSUE_FILE" 2>/dev/null || true
fi

echo "dogos-live-password: live password randomized for '$LIVE_USER' and shown on the login screen"
