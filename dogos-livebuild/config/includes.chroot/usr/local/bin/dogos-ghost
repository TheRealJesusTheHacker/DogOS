#!/bin/bash
# dogos-ghost — Ghost mode: route all TCP/DNS through Tor.
# SCOPE: recon/anonymity phase. NOT for full engagements (see design spec).
#
# Mechanism: nftables nat table redirects TCP -> Tor TransPort (9040) and
# DNS -> Tor DNSPort (5353). Tor's own traffic is excluded by UID so it
# doesn't loop back into itself.
#
# HONEST LIMITS:
#  - Non-DNS UDP and ICMP BYPASS Tor. Run a leak test before trusting it.
#  - Tor exits are blocked by many targets; latency kills interactive shells.
#  - Running attacks through volunteer exits burns community goodwill.
set -euo pipefail
[ "$(id -u)" -eq 0 ] || { echo "error: run as root"; exit 1; }

# Resolve our own path once, up front: the portal timer re-execs "$0", and
# a relative $0 would break (silently) if the timer's CWD ever differed.
SCRIPT_ABS="$(readlink -f "$(command -v "$0" 2>/dev/null || printf '%s' "$0")" 2>/dev/null || printf '%s' "$0")"

TRANSPORT_PORT=9040
DNS_PORT=5353
GHOST_RULES="/etc/nftables.d/ghost.nft"
# Portal-hatch marker: holds the epoch at which the hatch EXPIRES.
# Volatile (/run) so a reboot can never leave a stale marker behind.
PORTAL_MARKER="/run/dogos-ghost-portal"

write_rules() {
  local tor_uid tmp
  tor_uid="$(id -u debian-tor 2>/dev/null || echo 0)"
  [ "$tor_uid" != "0" ] || { echo "tor user 'debian-tor' not found — is tor installed?"; exit 1; }
  mkdir -p /etc/nftables.d
  # Atomic publish: a concurrent `dogos-ghost on` (e.g. the portal timer
  # firing while you run it by hand) must never catch `nft -f` reading a
  # half-written rules file — a parse error there would leave the ghost
  # table deleted but never reloaded (ghost silently OFF).
  tmp="$(mktemp /etc/nftables.d/.ghost.nft.XXXXXX)" || exit 1
  if ! cat > "$tmp" <<EOF
# DogOS Ghost mode — generated by dogos-ghost. Do not hand-edit.
table inet ghost {
    chain output {
        type nat hook output priority -100; policy accept;
        # Tor's own traffic must not loop back into Tor
        meta skuid $tor_uid return
        # ...neither should localhost
        oif "lo" return
        # DNS -> Tor DNSPort
        udp dport 53 redirect to :$DNS_PORT
        tcp dport 53 redirect to :$DNS_PORT
        # Everything else TCP -> Tor TransPort
        tcp dport != $TRANSPORT_PORT redirect to :$TRANSPORT_PORT
    }
}
EOF
  then
    rm -f "$tmp"
    echo "ERROR: could not write ghost rules — network untouched"
    exit 1
  fi
  mv -f "$tmp" "$GHOST_RULES"
}

case "${1:-}" in
  on)
    # A pending portal timer must never re-fire after an explicit `on`:
    # the marker is gone, so the timer stands down (see portal branch).
    rm -f "$PORTAL_MARKER"
    cat <<'EOF'
[!] Ghost mode: recon/anonymity phase ONLY.
    - Non-DNS UDP and ICMP BYPASS Tor — verify with a leak test.
    - Exits are blocked by many targets; latency kills interactive shells.
    - Turn OFF before active engagement:  dogos-ghost off
EOF
    # Fail BEFORE any side effects if tor is missing: write_rules repeats
    # this check, but only after the torrc is written and tor restarted.
    id -u debian-tor >/dev/null 2>&1 \
      || { echo "tor user 'debian-tor' not found — is tor installed?"; exit 1; }
    # Tor transparent-proxy ports (Debian tor reads /etc/tor/torrc.d/)
    mkdir -p /etc/tor/torrc.d
    cat > /etc/tor/torrc.d/dogos-ghost.conf <<EOF2
TransPort 127.0.0.1:$TRANSPORT_PORT
DNSPort 127.0.0.1:$DNS_PORT
VirtualAddrNetworkIPv4 10.192.0.0/10
AutomapHostsOnResolve 1
EOF2
    systemctl restart tor
    echo "waiting for Tor TransPort..."
    up=0
    for _ in $(seq 1 30); do
      if (echo > /dev/tcp/127.0.0.1/$TRANSPORT_PORT) 2>/dev/null; then up=1; break; fi
      sleep 1
    done
    if [ "$up" -ne 1 ]; then
      echo "ERROR: Tor TransPort not listening after 30s — ghost NOT enabled (network untouched)"
      exit 1
    fi
    write_rules
    # idempotent: clear any previous ghost table before loading
    nft delete table inet ghost 2>/dev/null || true
    nft -f "$GHOST_RULES"
    echo "Ghost mode ON."
    echo "Verify: curl --noproxy '*' https://check.torproject.org/api/ip"
    ;;
  off)
    # Cancel any pending portal timer: deleting the marker means the timer
    # can never re-enable Tor after an explicit `off`.
    rm -f "$PORTAL_MARKER"
    nft delete table inet ghost 2>/dev/null || true
    rm -f "$GHOST_RULES"
    # NOTE: /etc/tor/torrc.d/dogos-ghost.conf is deliberately LEFT in place
    # and tor is NOT restarted here. TransPort/DNSPort only listen on
    # 127.0.0.1 and nothing routes into them without the ghost nft table,
    # so the open ports are inert — and keeping the config means `on`
    # doesn't pay a tor restart on every toggle.
    echo "Ghost mode OFF — traffic is direct again."
    ;;
  portal)
    # Captive-portal hatch: drop the redirect so the hotel/cafe login page
    # loads, then re-enable automatically after 5 minutes.
    nft delete table inet ghost 2>/dev/null || true
    # Timestamped marker: the re-enable timer below only fires if this
    # marker still exists AND the full 5 minutes have elapsed since the
    # LATEST `portal` run. Running `on` or `off` deletes the marker, so
    # `portal` followed by `off` can never silently re-enable Tor; running
    # `portal` twice pushes the expiry forward, so the stale first timer
    # stands down instead of re-enabling early.
    printf '%s\n' "$(( $(date +%s) + 300 ))" > "$PORTAL_MARKER"
    echo "Portal hatch open for 5 minutes — log in, then run: dogos-ghost on"
    # HUP-immune and detached: closing the terminal must not kill the timer,
    # or ghost mode would silently stay OFF past the 5 minutes.
    ( trap '' HUP; sleep 300
      now="$(date +%s)"
      expiry="$(cat "$PORTAL_MARKER" 2>/dev/null || echo 0)"
      rm -f "$PORTAL_MARKER"
      case "$expiry" in ''|*[!0-9]*) exit 0;; esac
      if [ "$now" -ge "$expiry" ]; then
        exec "$SCRIPT_ABS" on
      fi
    ) >/dev/null 2>&1 &
    disown 2>/dev/null || true
    ;;
  status)
    if nft list table inet ghost >/dev/null 2>&1; then
      echo "Ghost mode: ON"
    else
      echo "Ghost mode: OFF"
    fi
    systemctl is-active tor 2>/dev/null || echo "tor: not running"
    ;;
  per-app)
    echo "Per-app routing (no full tunnel needed):"
    echo "  torsocks <cmd>      # torify a single command"
    echo "  proxychains4 <cmd>  # via /etc/proxychains4.conf"
    ;;
  *)
    echo "usage: dogos-ghost {on|off|portal|status|per-app}"
    exit 1
    ;;
esac
